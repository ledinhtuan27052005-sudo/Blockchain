# =========================================================================
# CẤU HÌNH GỬI EMAIL XÁC THỰC OTP QUA GMAIL SMTP
# =========================================================================
# 1. GMAIL_USER: Địa chỉ email Gmail của bạn dùng để gửi thư
# 2. GMAIL_APP_PASSWORD: Mật khẩu ứng dụng 16 ký tự do Google cấp (App Password)
#    (Lưu ý: Không phải mật khẩu đăng nhập Gmail thông thường)
#    Cách lấy: Vào https://myaccount.google.com/apppasswords -> Đăng nhập -> Tạo App Password -> Dán mã 16 ký tự vào đây
GMAIL_USER=
GMAIL_APP_PASSWORD=

# =========================================================================
# CẤU HÌNH MẠNG ETHEREUM BLOCKCHAIN (TÙY CHỌN)
# =========================================================================
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRIVATE_KEY=your_private_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here
