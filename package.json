{
  "name": "blockchain-warranty-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Product Warranty and Service History System on Blockchain",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "ganache": "ganache --wallet.mnemonic \"test test test test test test test test test test test junk\" --port 8545 --chain.chainId 1337",
    "compile": "node scripts/compile.js",
    "deploy": "node scripts/deploy.js"
  },
  "keywords": [
    "blockchain",
    "solidity",
    "warranty",
    "smart-contract"
  ],
  "author": "Student Project",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "docx": "^9.8.1",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "nodemailer": "^10.0.10",
    "solc": "^0.8.20"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "ganache": "^7.9.2"
  }
}
